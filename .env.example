# Required before a production deployment. Do not include a trailing slash.
PUBLIC_SITE_URL=https://www.your-marketing-domain.example

# Confirmed product demo.
PUBLIC_APP_URL=https://caremin-six.vercel.app

# Required by the server-side /api/contact function. Never prefix this with PUBLIC_.
CONTACT_EMAIL=owner@example.com

# Optional. Analytics stay fully disabled when these are blank.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Required when the privacy and terms placeholders are replaced for launch.
PUBLIC_LEGAL_NAME=
PUBLIC_ABN=
