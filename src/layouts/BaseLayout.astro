---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BrandLogo from "../components/BrandLogo.astro";
import { site } from "../config/site";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  hideChrome?: boolean;
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
  ogType = "website",
  structuredData: pageStructuredData = [],
  hideChrome = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, site.siteUrl).toString();
const socialImage = new URL("/brand/caremin-full.png", site.siteUrl).toString();
const pageGraph = Array.isArray(pageStructuredData) ? pageStructuredData : [pageStructuredData];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.siteUrl}#organisation`,
      name: "CareMin",
      url: site.siteUrl,
      logo: new URL("/brand/caremin-icon.png", site.siteUrl).toString(),
      sameAs: [site.linkedInUrl],
    },
    {
      "@type": "WebSite",
      "@id": `${site.siteUrl}#website`,
      name: "CareMin",
      url: site.siteUrl,
      inLanguage: "en-AU",
      publisher: { "@id": `${site.siteUrl}#organisation` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site.siteUrl}#software`,
      name: "CareMin",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description: site.description,
      areaServed: {
        "@type": "Country",
        name: "Australia",
      },
      url: site.siteUrl,
      publisher: { "@id": `${site.siteUrl}#organisation` },
    },
    ...pageGraph,
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e2b35" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      site.searchConsoleVerification && (
        <meta name="google-site-verification" content={site.searchConsoleVerification} />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="CareMin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="CareMin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      site.analyticsDomain && (
        <script is:inline defer data-domain={site.analyticsDomain} src={site.analyticsScriptUrl} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {!hideChrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && <Footer />}

    <div class="app-transition" data-app-transition hidden>
      <div class="app-transition-panel" role="status" aria-live="polite" aria-atomic="true">
        <div class="app-transition-logo"><BrandLogo /></div>
        <h2>Opening CareMin</h2>
        <p>Your workspace will be ready shortly.</p>
        <span class="app-transition-progress" aria-hidden="true"><i></i></span>
      </div>
    </div>

    <script>
      const appTransition = document.querySelector<HTMLElement>("[data-app-transition]");
      const appLinks = document.querySelectorAll<HTMLAnchorElement>("[data-app-link]");
      let appNavigationStarted = false;

      function resetAppTransition() {
        appNavigationStarted = false;
        appTransition?.setAttribute("hidden", "");
        document.body.removeAttribute("data-app-transitioning");
        document.body.removeAttribute("aria-busy");
      }

      appLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            link.target === "_blank" ||
            appNavigationStarted
          ) {
            return;
          }

          event.preventDefault();
          appNavigationStarted = true;
          appTransition?.removeAttribute("hidden");
          document.body.setAttribute("data-app-transitioning", "");
          document.body.setAttribute("aria-busy", "true");

          requestAnimationFrame(() => {
            requestAnimationFrame(() => window.location.assign(link.href));
          });
        });
      });

      window.addEventListener("pageshow", resetAppTransition);
    </script>
  </body>
</html>
