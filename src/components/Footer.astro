---
import { site } from "../config/site";
import BrandLogo from "./BrandLogo.astro";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand-link brand-link--footer" href="/" aria-label="CareMin home">
        <BrandLogo variant="footer" />
      </a>
      <p>Care-minute monitoring and evidence for Australian residential aged care.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div>
        <p class="footer-label">Product</p>
        <a href="/#how-it-works">How it works</a>
        <a href="/#capabilities">Capabilities</a>
        <a href="/care-minutes-software">Care minutes software</a>
        <a href={site.appUrl}>Sign in</a>
      </div>
      <div>
        <p class="footer-label">Resources</p>
        <a href="/resources">All resources</a>
        <a href="/care-minutes-performance-statement">Performance statement</a>
        <a href="/24-7-rn-coverage">24/7 RN coverage</a>
        <a href="/care-minutes-calculator">Calculator</a>
      </div>
      <div>
        <p class="footer-label">Company</p>
        <a href="/#contact">Contact</a>
        <a href={site.linkedInUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>Care-minute monitoring, RN coverage, planning, and evidence in one connected workspace.</p>
    <p>&copy; {site.buildYear} CareMin. All rights reserved.</p>
  </div>
</footer>
