---
interface Props {
  name:
    | "database"
    | "roles"
    | "trend"
    | "evidence"
    | "upload"
    | "review"
    | "monitor"
    | "file"
    | "coverage"
    | "shield"
    | "scenario"
    | "external";
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "database" && (
      <>
        <ellipse cx="12" cy="5" rx="8" ry="3" />
        <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
        <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
      </>
    )
  }
  {
    name === "roles" && (
      <>
        <circle cx="9" cy="8" r="3" />
        <path d="M3.5 19c.4-3.1 2.25-5 5.5-5s5.1 1.9 5.5 5" />
        <path d="m16 8 1.5 1.5L21 6" />
      </>
    )
  }
  {
    name === "trend" && (
      <>
        <path d="M4 19V5" />
        <path d="M4 19h16" />
        <path d="m7 15 4-4 3 2 5-6" />
      </>
    )
  }
  {
    name === "evidence" && (
      <>
        <path d="M6 3h9l3 3v15H6z" />
        <path d="M14 3v4h4" />
        <path d="m9 14 2 2 4-5" />
      </>
    )
  }
  {
    name === "upload" && (
      <>
        <path d="M12 16V4" />
        <path d="m7 9 5-5 5 5" />
        <path d="M5 14v5h14v-5" />
      </>
    )
  }
  {
    name === "review" && (
      <>
        <circle cx="11" cy="11" r="6" />
        <path d="m16 16 4 4" />
        <path d="m8.5 11 1.5 1.5 3-3" />
      </>
    )
  }
  {
    name === "monitor" && (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8M12 17v4" />
        <path d="m7 13 3-3 2 2 4-5" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M6 3h9l3 3v15H6z" />
        <path d="M14 3v4h4M9 12h6M9 16h6" />
      </>
    )
  }
  {
    name === "coverage" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <path d="M12 7v5l3 2" />
        <path d="M9 2h6" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M12 3 5 6v5c0 4.6 2.7 8.2 7 10 4.3-1.8 7-5.4 7-10V6z" />
        <path d="m9 12 2 2 4-5" />
      </>
    )
  }
  {
    name === "scenario" && (
      <>
        <path d="M4 19V5M4 19h16" />
        <path d="M8 16v-4M12 16V8M16 16v-7" />
      </>
    )
  }
  {
    name === "external" && (
      <>
        <path d="M14 5h5v5" />
        <path d="m19 5-8 8" />
        <path d="M18 13v6H5V6h6" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: block;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
