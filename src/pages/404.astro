---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | CareMin"
  description="The requested CareMin page could not be found."
  noindex={true}
>
  <section class="error-page">
    <div class="container error-page-inner">
      <p class="error-code">404</p>
      <h1>This page could not be found.</h1>
      <p>The address may have changed, or the page may no longer be available.</p>
      <a class="button" href="/">Return to CareMin</a>
    </div>
  </section>
</BaseLayout>
