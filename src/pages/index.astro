---
import Icon from "../components/Icon.astro";
import { primarySources, site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const problemCards = [
  {
    icon: "database" as const,
    title: "Data spread across systems",
    body: "Worked hours, agency shifts, resident data, and reporting inputs often arrive from separate systems and owners.",
  },
  {
    icon: "roles" as const,
    title: "Eligibility needs review",
    body: "Role titles and activities need consistent decisions before time is included in a care-minute result.",
  },
  {
    icon: "trend" as const,
    title: "Shortfalls discovered late",
    body: "Quarterly totals can conceal a developing gap until there is limited time to investigate or respond.",
  },
  {
    icon: "evidence" as const,
    title: "Evidence assembled later",
    body: "A final figure is difficult to explain when source files, corrections, and calculation records are kept separately.",
  },
];

const steps = [
  {
    icon: "upload" as const,
    title: "Import",
    body: "Add worked-hours and resident data from existing systems in common structured formats.",
  },
  {
    icon: "review" as const,
    title: "Review",
    body: "Resolve file-quality warnings and ambiguous role classifications before relying on results.",
  },
  {
    icon: "monitor" as const,
    title: "Monitor",
    body: "Compare daily and quarter-to-date results with each facility's own targets.",
  },
  {
    icon: "evidence" as const,
    title: "Evidence",
    body: "Keep source files, import records, row references, and calculation versions together.",
  },
];

const capabilities = [
  {
    icon: "trend" as const,
    title: "Care-minute position",
    body: "See the current result against the target that applies to each home.",
    items: [
      "Daily and quarter-to-date results",
      "Total, RN, and EN contribution views",
      "Home-specific targets",
      "Data-age and shortfall warnings",
    ],
  },
  {
    icon: "coverage" as const,
    title: "RN coverage",
    body: "Review continuous RN coverage alongside care-minute performance.",
    items: ["Continuous coverage checks", "Gaps of 30 minutes or more", "Monthly review support"],
  },
  {
    icon: "review" as const,
    title: "Data review",
    body: "Keep uncertain data visible and outside results until it is reviewed.",
    items: [
      "Structured file imports",
      "Role eligibility queue",
      "Excluded and unresolved rows shown separately",
      "Import quality warnings",
    ],
  },
  {
    icon: "shield" as const,
    title: "Evidence and outputs",
    body: "Retain the information needed to retrace a figure and prepare review material.",
    items: [
      "Retained source files",
      "Import and calculation records",
      "CSV, Excel, and PDF outputs",
      "Calculation version and original row references",
    ],
  },
  {
    icon: "scenario" as const,
    title: "Operational planning",
    body: "Test basic staffing and occupancy changes without altering the underlying record.",
    items: [
      "Staffing scenarios",
      "Occupancy changes",
      "Facility-level views",
      "Multiple facilities per provider",
    ],
  },
];

const faqItems = [
  {
    question: "Does CareMin submit reports to GPMS?",
    answer:
      "No. CareMin supports monitoring, review, and evidence preparation. The provider remains responsible for checking and submitting information through the required government channels.",
  },
  {
    question: "Does every home use a target of 215 minutes and 44 RN minutes?",
    answer:
      "No. Those are sector-wide averages. Each home has targets that reflect its resident case mix.",
  },
  {
    question: "Which staff can contribute to care minutes?",
    answer:
      "Eligible direct care may be delivered by registered nurses, enrolled nurses, and personal care workers or assistants in nursing, subject to the applicable rules and reporting guidance. CareMin keeps unresolved roles out of calculated results until reviewed.",
  },
  {
    question: "Can we use our existing exports?",
    answer:
      "CareMin accepts common structured file formats and is designed to work with exports from existing systems. File quality and field availability still determine what can be calculated reliably.",
  },
  {
    question: "Does CareMin replace our auditor?",
    answer:
      "No. CareMin helps maintain a reviewable record. It does not provide an audit opinion or replace a registered company auditor.",
  },
  {
    question: "Is CareMin a rostering or payroll system?",
    answer: "No. It works alongside existing operational systems.",
  },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Care minutes for residential aged care</p>
        <h1 id="hero-title">See where your care minutes stand before the quarter closes.</h1>
        <p>
          CareMin brings worked hours, occupied bed days, role eligibility, and source evidence into
          one place. Monitor facility performance, investigate gaps, and prepare a clearer reporting
          record.
        </p>
        <div class="hero-actions">
          <a class="button" href="#contact">Request a walkthrough</a>
          <a class="button button--secondary" href={site.appUrl}>Sign in</a>
        </div>
        <p class="hero-note">Built for Australian residential aged care providers</p>
      </div>

      <div class="product-preview-wrap" aria-label="CareMin sample dashboard preview">
        <div class="preview-glow" aria-hidden="true"></div>
        <div class="product-preview">
          <div class="browser-bar" aria-hidden="true">
            <div class="browser-dots"><span></span><span></span><span></span></div>
            <span class="sample-label">Sample data</span>
          </div>
          <div class="dashboard">
            <aside class="dashboard-sidebar" aria-hidden="true">
              <div class="mini-brand">
                <img src="/favicon.png" alt="" width="1024" height="1024" />
                <span>CareMin</span>
              </div>
              <div class="sidebar-item is-active">Overview</div>
              <div class="sidebar-item">Care minutes</div>
              <div class="sidebar-item">RN coverage</div>
              <div class="sidebar-item">Eligibility</div>
              <div class="sidebar-item">Evidence</div>
            </aside>

            <div class="dashboard-main">
              <div class="dashboard-heading">
                <div>
                  <p>Sample facility</p>
                  <h2>Quarter-to-date position</h2>
                </div>
                <span class="date-chip">Updated 4 Aug 2026</span>
              </div>

              <div class="metric-grid">
                <div class="metric-card">
                  <p class="metric-label">Total care minutes</p>
                  <p class="metric-value">211.8 <span>min / OBD</span></p>
                  <p class="metric-meta"><span class="status-dot is-amber"></span> Target 213.2</p>
                </div>
                <div class="metric-card">
                  <p class="metric-label">RN care minutes</p>
                  <p class="metric-value">45.1 <span>min / OBD</span></p>
                  <p class="metric-meta"><span class="status-dot"></span> Target 43.7</p>
                </div>
                <div class="metric-card">
                  <p class="metric-label">Occupied bed days</p>
                  <p class="metric-value">5,984 <span>QTD</span></p>
                  <p class="metric-meta"><span class="status-dot"></span> Complete to 3 Aug</p>
                </div>
              </div>

              <div class="dashboard-lower">
                <div class="chart-card">
                  <div class="card-title-row">
                    <h3>Daily care-minute trend</h3>
                    <div class="chart-legend" aria-hidden="true">
                      <span class="legend-item">Actual</span>
                      <span class="legend-item is-target">Target</span>
                    </div>
                  </div>
                  <svg
                    class="trend-chart"
                    viewBox="0 0 360 126"
                    role="img"
                    aria-label="Sample daily care minutes fluctuating around the facility target"
                  >
                    <defs>
                      <linearGradient id="chartArea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#13b9bb" stop-opacity="0.22"></stop>
                        <stop offset="100%" stop-color="#13b9bb" stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>
                    <g stroke="#e4eaed" stroke-width="1">
                      <line x1="0" y1="20" x2="360" y2="20"></line>
                      <line x1="0" y1="59" x2="360" y2="59"></line>
                      <line x1="0" y1="98" x2="360" y2="98"></line>
                    </g>
                    <line
                      x1="0"
                      y1="55"
                      x2="360"
                      y2="55"
                      stroke="#91a2ac"
                      stroke-width="1.5"
                      stroke-dasharray="5 5"></line>
                    <path
                      d="M0 82 C20 72 32 43 52 50 S81 77 102 68 S131 38 153 47 S182 72 204 61 S235 40 257 50 S283 82 306 66 S337 43 360 48 L360 116 L0 116 Z"
                      fill="url(#chartArea)"></path>
                    <path
                      d="M0 82 C20 72 32 43 52 50 S81 77 102 68 S131 38 153 47 S182 72 204 61 S235 40 257 50 S283 82 306 66 S337 43 360 48"
                      fill="none"
                      stroke="#07979b"
                      stroke-width="3"
                      stroke-linecap="round"></path>
                    <circle cx="360" cy="48" r="4" fill="#07979b" stroke="#fff" stroke-width="2"
                    ></circle>
                  </svg>
                </div>

                <div class="evidence-card">
                  <div class="card-title-row">
                    <h3>Evidence status</h3>
                    <span class="review-badge">2 to review</span>
                  </div>
                  <ul class="evidence-list">
                    <li>Worked-hours imports current</li>
                    <li>Occupied bed days current</li>
                    <li class="is-review">Two unresolved role labels</li>
                    <li>Calculation record retained</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="context-strip" aria-label="Care-minute context">
    <div class="container context-grid">
      <div class="context-item">
        <span class="context-value">215</span>
        <p>
          sector-wide average care minutes
          <a href={primarySources.careMinutes} target="_blank" rel="noopener noreferrer">Source</a>
        </p>
      </div>
      <div class="context-item">
        <span class="context-value">44</span>
        <p>
          sector-wide average RN minutes
          <a href={primarySources.careMinutes} target="_blank" rel="noopener noreferrer">Source</a>
        </p>
      </div>
      <div class="context-item context-item--note">
        <span class="context-icon" aria-hidden="true">i</span>
        <p>
          <strong>Targets vary by home.</strong> Providers remain responsible for confirming the facility-specific
          targets and occupied bed-day source data used in their submissions.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="problem-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">The reporting challenge</p>
        <h2 id="problem-title">The final number is only part of the work.</h2>
        <p>
          Care-minute reporting depends on the right worked hours, eligible occupations, reporting
          period, and occupied bed days. When those inputs live in separate exports and
          spreadsheets, it becomes difficult to see the current position or explain how a result was
          produced.
        </p>
      </div>

      <div class="problem-grid">
        {
          problemCards.map((card, index) => (
            <article class="problem-card">
              <p class="card-number">0{index + 1}</p>
              <span class="icon-box">
                <Icon name={card.icon} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section-heading section-heading--centred">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">From source files to a reviewable care-minute position.</h2>
        <p>
          CareMin provides a controlled path from operational exports to a result your team can
          inspect and explain.
        </p>
      </div>

      <div class="steps">
        {
          steps.map((step) => (
            <article class="step-card">
              <span class="step-icon">
                <Icon name={step.icon} />
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="capabilities" class="section section--soft" aria-labelledby="capabilities-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Product capabilities</p>
        <h2 id="capabilities-title">One workspace for monitoring, review, and evidence.</h2>
        <p>
          Follow the current care-minute position while keeping unresolved inputs and source records
          visible.
        </p>
      </div>

      <div class="capability-grid">
        {
          capabilities.map((capability) => (
            <article class="capability-card">
              <span class="icon-box">
                <Icon name={capability.icon} />
              </span>
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
              <ul>
                {capability.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="evidence-title">
    <div class="container evidence-layout">
      <div class="evidence-copy">
        <p class="eyebrow">Calculation lineage</p>
        <h2 id="evidence-title">Keep the calculation and its source record together.</h2>
        <p>
          A care-minute result should be explainable. CareMin records the file, import, original
          row, eligibility decision, and calculation version behind the figures so teams can review
          changes and prepare supporting information.
        </p>
        <div class="evidence-detail">
          <span class="icon-box"><Icon name="file" /></span>
          <p>
            <strong>Trace a result back to the input.</strong><br />Retain source references without
            hiding corrections or unresolved decisions.
          </p>
        </div>
      </div>

      <div class="lineage-panel" aria-label="Example evidence lineage">
        <div class="lineage-panel-header">
          <p>Evidence lineage</p>
          <span class="lineage-status">Record linked</span>
        </div>
        <ol class="lineage-flow">
          <li class="lineage-node">
            <span>01</span><strong>Source file</strong><small>Worked hours CSV</small>
          </li>
          <li class="lineage-node">
            <span>02</span><strong>Import receipt</strong><small>Time and file checksum</small>
          </li>
          <li class="lineage-node">
            <span>03</span><strong>Normalised row</strong><small>Original row retained</small>
          </li>
          <li class="lineage-node">
            <span>04</span><strong>Eligibility decision</strong><small
              >RN direct care included</small
            >
          </li>
          <li class="lineage-node is-current">
            <span>05</span><strong>Calculation</strong><small>Version and target recorded</small>
          </li>
          <li class="lineage-node">
            <span>06</span><strong>Output</strong><small>Reviewable PDF and Excel</small>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section id="reporting" class="section" aria-labelledby="reporting-title">
    <div class="container reporting-layout">
      <div class="reporting-copy">
        <p class="eyebrow">Reporting context</p>
        <h2 id="reporting-title">Built around the way care minutes are reviewed and reported.</h2>
        <p>
          Australian residential aged care providers have care-minute responsibilities under the
          Aged Care Act 2024 and Aged Care Rules 2025. Providers continue to report labour hours and
          costs through the Quarterly Financial Report and RN coverage through monthly reporting.
        </p>
        <p>
          From the 2025-26 Aged Care Financial Report, providers must also submit an externally
          audited Care Minutes Performance Statement. The first statement is due on 31 October 2026.
        </p>
        <div class="reporting-note">
          CareMin helps organise and review care-minute inputs and evidence. It does not submit
          reports to government systems or replace professional assurance.
        </div>
      </div>

      <ol class="reporting-list">
        <li class="reporting-item">
          <span class="reporting-item-number">01</span>
          <div>
            <strong>Care minutes</strong>
            <p>Current Australian Government program guidance and targets.</p>
          </div>
          <a
            class="source-link"
            href={primarySources.careMinutes}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Australian Government care minutes guidance in a new tab"
            ><Icon name="external" size={19} /></a
          >
        </li>
        <li class="reporting-item">
          <span class="reporting-item-number">02</span>
          <div>
            <strong>Quarterly Financial Report</strong>
            <p>Facility-level labour costs and hours reporting.</p>
          </div>
          <a
            class="source-link"
            href={primarySources.quarterlyFinancialReport}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Quarterly Financial Report guidance in a new tab"
            ><Icon name="external" size={19} /></a
          >
        </li>
        <li class="reporting-item">
          <span class="reporting-item-number">03</span>
          <div>
            <strong>24/7 RN reporting</strong>
            <p>Monthly reporting and absences of 30 minutes or more.</p>
          </div>
          <a
            class="source-link"
            href={primarySources.rnReporting}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open 24/7 RN reporting guidance in a new tab"
            ><Icon name="external" size={19} /></a
          >
        </li>
        <li class="reporting-item">
          <span class="reporting-item-number">04</span>
          <div>
            <strong>Care Minutes Performance Statement</strong>
            <p>External audit requirements and preparation guidance.</p>
          </div>
          <a
            class="source-link"
            href={primarySources.performanceStatement}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Care Minutes Performance Statement guidance in a new tab"
            ><Icon name="external" size={19} /></a
          >
        </li>
        <li class="reporting-item">
          <span class="reporting-item-number">05</span>
          <div>
            <strong>Aged Care Rules 2025</strong>
            <p>Current text on the Federal Register of Legislation.</p>
          </div>
          <a
            class="source-link"
            href={primarySources.agedCareRules}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open the Aged Care Rules 2025 in a new tab"
            ><Icon name="external" size={19} /></a
          >
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="audience-title">
    <div class="container">
      <div class="section-heading section-heading--centred">
        <p class="eyebrow">For provider teams</p>
        <h2 id="audience-title">Designed for the people responsible for the result.</h2>
        <p>Give each team a clearer view of the same controlled care-minute record.</p>
      </div>

      <div class="audience-grid">
        <article class="audience-card">
          <span class="role-mark">FM</span>
          <h3>Facility managers</h3>
          <p>Monitor daily performance and investigate developing gaps.</p>
        </article>
        <article class="audience-card">
          <span class="role-mark">DN</span>
          <h3>Directors of Nursing</h3>
          <p>Review RN coverage and staffing risk.</p>
        </article>
        <article class="audience-card">
          <span class="role-mark">CT</span>
          <h3>Compliance teams</h3>
          <p>Prepare source records and calculation evidence.</p>
        </article>
        <article class="audience-card">
          <span class="role-mark">OL</span>
          <h3>Operations leaders</h3>
          <p>Compare facility positions and data quality.</p>
        </article>
        <article class="audience-card">
          <span class="role-mark">FT</span>
          <h3>Finance teams</h3>
          <p>Review and reconcile reporting inputs.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <div class="faq-intro">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Clear boundaries, clearly stated.</h2>
        <p>
          CareMin supports your reporting process. Provider review and professional assurance remain
          essential.
        </p>
      </div>

      <div class="faq-list">
        {
          faqItems.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}</summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <div class="contact-copy">
        <p class="eyebrow">Request a walkthrough</p>
        <h2 id="contact-title">Review your care-minute process with CareMin.</h2>
        <p>
          See how CareMin imports facility data, surfaces unresolved items, calculates the current
          position, and keeps the supporting record together.
        </p>
        <a class="contact-email" href={`mailto:${site.contactEmail}`}>
          <Icon name="mail" size={20} />
          {site.contactEmail}
        </a>
      </div>

      <form class="contact-form" action={site.contactFormEndpoint} method="POST">
        <input type="hidden" name="_subject" value="New CareMin walkthrough request" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={`${site.siteUrl}/thank-you`} />
        <div class="honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="organisation">Organisation</label>
          <input
            id="organisation"
            name="organisation"
            type="text"
            autocomplete="organization"
            required
          />
        </div>
        <div class="form-field">
          <label for="homes">Number of homes</label>
          <select id="homes" name="number_of_homes" required>
            <option value="">Select</option>
            <option value="1">1 home</option>
            <option value="2-5">2 to 5 homes</option>
            <option value="6-10">6 to 10 homes</option>
            <option value="11+">11 or more homes</option>
          </select>
        </div>
        <div class="form-field form-field--full">
          <label for="message">What would you like to review?</label>
          <textarea
            id="message"
            name="message"
            aria-describedby="message-hint"
            placeholder="For example, current care-minute monitoring, RN coverage, or evidence preparation."
            required></textarea>
          <span id="message-hint" class="form-hint">
            Do not include resident names, health information, payroll data, or other sensitive
            data.
          </span>
        </div>
        <label class="form-consent">
          <input type="checkbox" name="contact_consent" value="Yes" required />
          <span>
            I agree that CareMin may use these details to respond to this enquiry. See the
            <a href="/privacy">privacy notice</a>.
          </span>
        </label>
        <div class="form-footer">
          <p>
            Protected by a honeypot and the form provider's anti-spam controls. No account or trial
            is created.
          </p>
          <button class="button" type="submit">Request walkthrough</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
