---
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import { resources } from "../config/resources";
import { primarySources, site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import fastrackLogo from "../assets/partners/fastrack.svg";
import monashLogo from "../assets/partners/monash.png";
import importComplete from "../assets/product/import-complete.png";
import importUpload from "../assets/product/import-upload.png";

const benefits = [
  {
    icon: "database" as const,
    title: "All inputs in one workspace",
    body: "Bring worked hours, agency shifts, occupied bed days, and reporting inputs together by facility and period.",
  },
  {
    icon: "roles" as const,
    title: "Consistent role classifications",
    body: "Apply repeatable eligibility decisions across imports and keep each decision connected to its source.",
  },
  {
    icon: "trend" as const,
    title: "Daily and quarter-to-date monitoring",
    body: "Review facility performance against the applicable targets throughout the reporting period.",
  },
  {
    icon: "evidence" as const,
    title: "Connected source evidence",
    body: "Keep each import, classification decision, and calculation connected to its supporting record.",
  },
];

const steps = [
  {
    icon: "upload" as const,
    title: "Import",
    body: "Add worked-hours and resident data from existing systems in common structured formats.",
  },
  {
    icon: "review" as const,
    title: "Classify",
    body: "Map roles once and apply consistent eligibility decisions across your imports.",
  },
  {
    icon: "monitor" as const,
    title: "Monitor",
    body: "Compare daily and quarter-to-date results with each facility's own targets.",
  },
  {
    icon: "evidence" as const,
    title: "Export",
    body: "Create PDF, Excel, and CSV outputs while retaining the supporting calculation record.",
  },
];

const capabilities = [
  {
    icon: "trend" as const,
    title: "Care-minute position",
    body: "See the current result against the target that applies to each home.",
    items: [
      "Daily and quarter-to-date results",
      "Total, RN, and EN contribution views",
      "Home-specific targets",
      "Performance and data-freshness indicators",
    ],
  },
  {
    icon: "coverage" as const,
    title: "RN coverage",
    body: "See the continuous RN coverage timeline alongside care-minute performance.",
    items: ["Daily coverage timeline", "Coverage continuity view", "Monthly reporting summaries"],
  },
  {
    icon: "review" as const,
    title: "Structured imports",
    body: "Turn existing exports into a structured, consistent care-minute record.",
    items: [
      "Staffing, roster, and occupied bed-day imports",
      "Reusable role classifications",
      "Clear import summaries",
      "Source-to-result links",
    ],
  },
  {
    icon: "shield" as const,
    title: "Evidence and outputs",
    body: "Move from a reported figure to its source record without leaving CareMin.",
    items: [
      "Retained source files",
      "Import and calculation records",
      "CSV, Excel, and PDF outputs",
      "Calculation version and original row references",
    ],
  },
  {
    icon: "scenario" as const,
    title: "Operational planning",
    body: "Model staffing and occupancy changes in dedicated planning scenarios.",
    items: [
      "Staffing scenarios",
      "Occupancy changes",
      "Facility-level views",
      "Multiple facilities per provider",
    ],
  },
];

const dataCommitments = [
  {
    icon: "shield" as const,
    title: "Australian data hosting",
    body: "Customer operational data stored by the CareMin application is hosted in Australia.",
  },
  {
    icon: "file" as const,
    title: "Handled under Australian privacy law",
    body: "Personal information is handled in accordance with the Privacy Act 1988 (Cth) and the Australian Privacy Principles where they apply.",
  },
  {
    icon: "database" as const,
    title: "Separated between customers",
    body: "Customer operational data is not shared with other CareMin customers, data brokers, or unrelated third parties.",
  },
  {
    icon: "evidence" as const,
    title: "Never sold or used for advertising",
    body: "We do not sell personal information or share it for advertising.",
  },
];

const faqItems = [
  {
    question: "Can CareMin use our existing exports?",
    answer:
      "Yes. CareMin works with common structured exports for staffing, rosters, and occupied bed days, bringing them together in one facility workspace.",
  },
  {
    question: "Does CareMin support multiple homes?",
    answer:
      "Yes. Provider teams can manage multiple facilities, view each home separately, and compare performance across the organisation.",
  },
  {
    question: "How does CareMin handle facility targets?",
    answer:
      "Each home's own care-minute and RN targets are stored in CareMin and applied throughout its daily and quarter-to-date views.",
  },
  {
    question: "What can we export from CareMin?",
    answer:
      "Teams can create CSV, Excel, and PDF outputs for operational reviews, leadership reporting, and evidence preparation.",
  },
  {
    question: "Which teams use CareMin?",
    answer:
      "Facility managers, Directors of Nursing, compliance teams, operations leaders, and finance teams can all work from the same care-minute record.",
  },
  {
    question: "Where does GPMS fit?",
    answer:
      "CareMin gives your team a connected workspace for monitoring and evidence preparation, ready to support your existing government reporting workflow.",
  },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-head">
        <h1 id="hero-title">Find the problem before the government does.</h1>
      </div>
      <div class="hero-copy">
        <p class="hero-summary">
          <strong>Keep your systems.</strong> CareMin turns the files you already export into care-minute
          results, RN coverage findings, and traceable evidence.
        </p>
        <div class="hero-cta">
          <a class="button button--large" href="#contact">Arrange a walkthrough</a>
          <a class="hero-sign-in" href={site.appUrl} data-app-link>
            Sign in <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="backing">
          <p id="backing-title" class="backing-statement">
            Backed by <strong>Monash University</strong> and <strong>Fastrack</strong>, its startup
            accelerator program.
          </p>
          <ul class="backing-logos" aria-label="CareMin supporters">
            <li class="backing-logo backing-logo--monash">
              <Image src={monashLogo} alt="Monash University" width={190} quality={90} />
            </li>
            <li class="backing-logo backing-logo--fastrack">
              <Image src={fastrackLogo} alt="Fastrack, Entrepreneurship at Monash" width={180} />
            </li>
          </ul>
        </div>
      </div>

      <figure class="hero-plaque plaque">
        <p class="plaque-bar">Care-minute monitoring and evidence</p>
        <div class="plaque-frame">
          <Image
            src={importComplete}
            alt="CareMin import results screen showing accepted files, completed checks, and an import summary"
            width={1500}
            format="webp"
            quality={86}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>Real product screen using demonstration data</figcaption>
      </figure>
    </div>
  </section>

  <section class="context" aria-label="Care-minute context">
    <div class="container context-grid">
      <div class="context-figure">
        <span class="context-value">215</span>
        <p>
          Sector-wide average care minutes<br />
          <a href={primarySources.careMinutes} target="_blank" rel="noopener noreferrer">Source</a>
        </p>
      </div>
      <div class="context-figure">
        <span class="context-value">44</span>
        <p>
          Sector-wide average RN minutes<br />
          <a href={primarySources.careMinutes} target="_blank" rel="noopener noreferrer">Source</a>
        </p>
      </div>
      <div class="context-note">
        <span class="context-note-mark" aria-hidden="true">i</span>
        <p>
          <strong>Targets are tailored by home.</strong> CareMin keeps facility-specific targets and occupied
          bed-day sources alongside daily and quarter-to-date results.
        </p>
      </div>
    </div>
  </section>

  <section class="section zone-white" aria-labelledby="benefits-title">
    <div class="container split">
      <div class="split-heading">
        <h2 id="benefits-title">A controlled record from import to output.</h2>
        <p class="lede">
          CareMin connects worked hours, role classifications, reporting periods, occupied bed days,
          and supporting evidence in one consistent facility record.
        </p>
      </div>

      <div class="benefit-list">
        {
          benefits.map((card) => (
            <article class="benefit">
              <span class="sign-icon">
                <Icon name={card.icon} />
              </span>
              <div>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section zone-aqua" aria-labelledby="how-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="how-title">A consistent process from source file to reported result.</h2>
        <p class="lede">Use the same controlled workflow for each facility and reporting period.</p>
      </div>

      <ol class="route" data-route>
        {
          steps.map((step) => (
            <li class="route-stop">
              <span class="route-marker">
                <Icon name={step.icon} />
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section zone-white" aria-labelledby="product-tour-title">
    <div class="container tour">
      <figure class="tour-plaque plaque">
        <p class="plaque-bar" aria-hidden="true">Universal import</p>
        <div class="plaque-frame">
          <Image
            src={importUpload}
            alt="CareMin upload workspace for adding staffing, occupied bed day, and roster exports"
            width={1500}
            format="webp"
            quality={86}
            loading="lazy"
          />
        </div>
        <figcaption>Upload workspace shown with demonstration data</figcaption>
      </figure>

      <div class="tour-copy">
        <h2 id="product-tour-title">Import existing operational exports.</h2>
        <p class="lede">
          Assign each source file to its facility and reporting period, review the imported data,
          and retain a structured receipt of the process.
        </p>
        <dl class="tour-points">
          <div>
            <dt>Guided import</dt>
            <dd>Add staffing, roster, and occupied bed-day files in one simple workflow.</dd>
          </div>
          <div>
            <dt>Consistent classification</dt>
            <dd>Turn role labels into reusable eligibility decisions across future imports.</dd>
          </div>
          <div>
            <dt>Connected records</dt>
            <dd>Carry source files and import receipts through to every later output.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="capabilities" class="section zone-eucalyptus" aria-labelledby="capabilities-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="capabilities-title">Monitoring, evidence, and reporting in one system.</h2>
        <p class="lede">
          Move easily between current performance, RN coverage, imports, evidence, and planning.
        </p>
      </div>

      <div class="directory">
        {
          capabilities.map((capability) => (
            <article class="directory-row">
              <div class="directory-name">
                <span class="sign-icon sign-icon--ink">
                  <Icon name={capability.icon} />
                </span>
                <div>
                  <h3>{capability.title}</h3>
                  <p>{capability.body}</p>
                </div>
              </div>
              <ul class="directory-items">
                {capability.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section zone-ink" aria-labelledby="evidence-title">
    <div class="container evidence">
      <div class="evidence-copy">
        <h2 id="evidence-title">Trace every result to its source.</h2>
        <p class="lede">
          CareMin links every figure to its source file, import receipt, original row, eligibility
          decision, and calculation version. The supporting record is retained as work progresses.
        </p>
        <div class="evidence-detail">
          <span class="sign-icon sign-icon--aqua"><Icon name="file" /></span>
          <p>
            <strong>Move from output to source in a few steps.</strong><br />See the records and
            decisions connected to every result.
          </p>
        </div>
      </div>

      <div class="lineage" aria-label="Example evidence lineage">
        <div class="lineage-header">
          <p>Evidence lineage</p>
          <span class="lineage-status">Record linked</span>
        </div>
        <ol class="lineage-flow">
          <li class="lineage-node">
            <span>01</span><strong>Source file</strong><small>Worked hours CSV</small>
          </li>
          <li class="lineage-node">
            <span>02</span><strong>Import receipt</strong><small>Time and file checksum</small>
          </li>
          <li class="lineage-node">
            <span>03</span><strong>Normalised row</strong><small>Original row retained</small>
          </li>
          <li class="lineage-node">
            <span>04</span><strong>Eligibility decision</strong><small
              >RN direct care included</small
            >
          </li>
          <li class="lineage-node is-current">
            <span>05</span><strong>Calculation</strong><small>Version and target recorded</small>
          </li>
          <li class="lineage-node">
            <span>06</span><strong>Output</strong><small>Reviewable PDF and Excel</small>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section id="reporting" class="section zone-white" aria-labelledby="reporting-title">
    <div class="container split">
      <div class="split-heading">
        <h2 id="reporting-title">Aligned to care-minute reporting and review.</h2>
        <p>
          CareMin is shaped around Australian residential aged care reporting. It brings care-minute
          monitoring, relevant Quarterly Financial Report inputs, and monthly RN coverage into a
          connected operating view.
        </p>
        <p>
          The 2025-26 Aged Care Financial Report introduces the externally audited Care Minutes
          Performance Statement, with the first statement due on 31 October 2026.
        </p>
        <div class="note">
          Imports, monitoring, evidence, and outputs remain connected throughout the reporting
          process.
        </div>
      </div>

      <ul class="source-list">
        <li>
          <a href={primarySources.careMinutes} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <strong>Care minutes</strong>
              <span>Current Australian Government program guidance and targets.</span>
            </span>
            <span class="source-go" aria-hidden="true"><Icon name="external" size={18} /></span>
            <span class="sr-only"
              >(opens Australian Government care minutes guidance in a new tab)</span
            >
          </a>
        </li>
        <li>
          <a
            href={primarySources.quarterlyFinancialReport}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="source-text">
              <strong>Quarterly Financial Report</strong>
              <span>Facility-level labour costs and hours reporting.</span>
            </span>
            <span class="source-go" aria-hidden="true"><Icon name="external" size={18} /></span>
            <span class="sr-only">(opens Quarterly Financial Report guidance in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={primarySources.rnReporting} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <strong>24/7 RN reporting</strong>
              <span>Monthly reporting and absences of 30 minutes or more.</span>
            </span>
            <span class="source-go" aria-hidden="true"><Icon name="external" size={18} /></span>
            <span class="sr-only">(opens 24/7 RN reporting guidance in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={primarySources.performanceStatement} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <strong>Care Minutes Performance Statement</strong>
              <span>External audit requirements and preparation guidance.</span>
            </span>
            <span class="source-go" aria-hidden="true"><Icon name="external" size={18} /></span>
            <span class="sr-only"
              >(opens Care Minutes Performance Statement guidance in a new tab)</span
            >
          </a>
        </li>
        <li>
          <a href={primarySources.agedCareRules} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <strong>Aged Care Rules 2025</strong>
              <span>Current text on the Federal Register of Legislation.</span>
            </span>
            <span class="source-go" aria-hidden="true"><Icon name="external" size={18} /></span>
            <span class="sr-only">(opens the Aged Care Rules 2025 in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section zone-eucalyptus" aria-labelledby="resources-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="resources-title">Care-minute reporting guides and tools.</h2>
        <p class="lede">
          Source-linked guidance for the reporting tasks behind CareMin, including the first audited
          Care Minutes Performance Statement.
        </p>
      </div>
      <div class="guide-grid">
        {
          resources.map((resource) => (
            <a class="guide" href={resource.path}>
              <h3>{resource.shortTitle}</h3>
              <p>{resource.description}</p>
              <span class="guide-go" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
        <a class="guide guide--all" href="/resources">View all resources →</a>
      </div>
    </div>
  </section>

  <section class="section zone-white" aria-labelledby="audience-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="audience-title">A shared record across operational and assurance teams.</h2>
        <p class="lede">
          Each team works from the same facility data, classifications, and supporting evidence.
        </p>
      </div>

      <div class="teams">
        <article class="team">
          <div class="door-sign">
            <span class="door-code" aria-hidden="true">FM</span>
            <h3>Facility managers</h3>
          </div>
          <p>Review daily performance and address staffing variance.</p>
        </article>
        <article class="team">
          <div class="door-sign">
            <span class="door-code" aria-hidden="true">DN</span>
            <h3>Directors of Nursing</h3>
          </div>
          <p>See RN coverage and care-minute performance together.</p>
        </article>
        <article class="team">
          <div class="door-sign">
            <span class="door-code" aria-hidden="true">CT</span>
            <h3>Compliance teams</h3>
          </div>
          <p>Build reporting evidence as the work happens.</p>
        </article>
        <article class="team">
          <div class="door-sign">
            <span class="door-code" aria-hidden="true">OL</span>
            <h3>Operations leaders</h3>
          </div>
          <p>Compare homes and coordinate support across the organisation.</p>
        </article>
        <article class="team">
          <div class="door-sign">
            <span class="door-code" aria-hidden="true">FT</span>
            <h3>Finance teams</h3>
          </div>
          <p>Reconcile hours, costs, and reporting inputs in one place.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="section zone-eucalyptus" aria-labelledby="faq-title">
    <div class="container split">
      <div class="split-heading split-heading--sticky">
        <h2 id="faq-title">Implementation and workflow questions.</h2>
        <p class="lede">How CareMin fits into an existing care-minute reporting process.</p>
      </div>

      <div class="faq">
        {
          faqItems.map((item, index) => (
            <details open={index === 0}>
              <summary>
                {item.question}
                <span class="faq-toggle" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section zone-white" aria-labelledby="data-title">
    <div class="container split">
      <div class="split-heading">
        <h2 id="data-title">Handling of the data you are trusted with.</h2>
        <p>
          CareMin holds staffing and resident information on behalf of your organisation. These
          commitments are published in full, alongside our retention and overseas processing
          practices, in the privacy notice.
        </p>
        <div class="note">
          Read the <a href="/privacy">privacy notice</a> for the complete detail, or report a suspected
          security issue to <a href={`mailto:${site.email.security}`}>{site.email.security}</a>.
        </div>
      </div>

      <ul class="commitments">
        {
          dataCommitments.map((commitment) => (
            <li>
              <span class="sign-icon">
                <Icon name={commitment.icon} size={22} />
              </span>
              <div>
                <strong>{commitment.title}</strong>
                <p>{commitment.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="contact zone-ink" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <div class="contact-copy">
        <h2 id="contact-title">Review CareMin against your current process.</h2>
        <p class="lede">
          Review imports, facility performance, RN coverage, evidence, and reporting outputs using a
          representative workflow.
        </p>
        <p>
          Prefer email? Write to <a href={`mailto:${site.email.demo}`}>{site.email.demo}</a>.
        </p>
      </div>

      <form class="contact-form" action={site.contactFormUrl} method="POST">
        <input type="hidden" name="_subject" value="New CareMin walkthrough request" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={`${site.siteUrl}/thank-you`} />
        <input type="hidden" name="_captcha" value="false" />
        <div class="honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="organisation">Organisation</label>
          <input
            id="organisation"
            name="organisation"
            type="text"
            autocomplete="organization"
            required
          />
        </div>
        <div class="form-field">
          <label for="homes">Number of homes</label>
          <select id="homes" name="number_of_homes" required>
            <option value="">Select</option>
            <option value="1">1 home</option>
            <option value="2-5">2 to 5 homes</option>
            <option value="6-10">6 to 10 homes</option>
            <option value="11+">11 or more homes</option>
          </select>
        </div>
        <div class="form-field form-field--full">
          <label for="message">What would you like to see?</label>
          <textarea
            id="message"
            name="message"
            aria-describedby="message-hint"
            placeholder="For example, care-minute monitoring, RN coverage, or reporting outputs."
            required></textarea>
          <span id="message-hint" class="form-hint">
            Use business contact information here; operational data can be discussed during the
            walkthrough.
          </span>
        </div>
        <label class="form-consent">
          <input type="checkbox" name="contact_consent" value="Yes" required />
          <span>
            I agree that CareMin may use these details to respond to this enquiry. See the{" "}
            <a href="/privacy">privacy notice</a>.
          </span>
        </label>
        <div class="form-footer">
          <p>We’ll reply to arrange a walkthrough tailored to your organisation.</p>
          <button class="button button--large" type="submit">Arrange walkthrough</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const route = document.querySelector<HTMLElement>("[data-route]");

  if (route && "IntersectionObserver" in window) {
    route.setAttribute("data-route-ready", "");
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          route.setAttribute("data-route-drawn", "");
          observer.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(route);
  }
</script>
